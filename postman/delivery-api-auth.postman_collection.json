{
  "info": {
    "name": "Delivery API - Auth Module",
    "_postman_id": "0f4f2f66-49d0-4b39-8d4b-3a3f1fa65a21",
    "description": "Postman collection for Delivery API auth endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3016"
    },
    {
      "key": "email",
      "value": "qa.auth@example.com"
    },
    {
      "key": "first_name",
      "value": "Sohaib"
    },
    {
      "key": "last_name",
      "value": "Tester"
    },
    {
      "key": "phone_number",
      "value": "03001234567"
    },
    {
      "key": "password",
      "value": "Passw0rdA!"
    },
    {
      "key": "new_password",
      "value": "Passw0rdB!"
    },
    {
      "key": "fcm_token",
      "value": "fcm-token-123"
    },
    {
      "key": "device_token",
      "value": "device-token-123"
    },
    {
      "key": "email_otp",
      "value": ""
    },
    {
      "key": "reset_otp",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('email', `qa.auth+${suffix}@example.com`);",
                  "pm.collectionVariables.set('phone_number', `03${Math.floor(100000000 + Math.random() * 900000000)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.otp) {",
                  "  pm.collectionVariables.set('email_otp', body.otp);",
                  "}",
                  "if (body?.data?.user?.email) {",
                  "  pm.collectionVariables.set('email', body.data.user.email);",
                  "}",
                  "pm.test('Signup returned user data', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.have.property('user');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"email\": \"{{email}}\",\n  \"phone_number\": \"{{phone_number}}\",\n  \"password\": \"{{password}}\",\n  \"confirm_password\": \"{{password}}\",\n  \"fcm_token\": \"{{fcm_token}}\",\n  \"token\": \"{{device_token}}\",\n  \"role\": \"customer\",\n  \"city\": \"Karachi\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "signup"
              ]
            },
            "description": "Create a new auth user and return OTP in non-production mode."
          },
          "response": []
        },
        {
          "name": "Verify Email OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verify status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{email_otp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/verify-email-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email-otp"
              ]
            },
            "description": "Verify email after signup using OTP."
          },
          "response": []
        },
        {
          "name": "Resend Email OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend OTP status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.otp) {",
                  "  pm.collectionVariables.set('email_otp', body.otp);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/resend-email-otp",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-email-otp"
              ]
            },
            "description": "Resend verification OTP if user is not yet verified."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body?.data?.access_token) {",
                  "  pm.collectionVariables.set('access_token', body.data.access_token);",
                  "}",
                  "if (body?.data?.refresh_token) {",
                  "  pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"fcm_token\": \"{{fcm_token}}\",\n  \"token\": \"{{device_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Login with verified email and password."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Forgot password status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "if (body.otp) {",
                  "  pm.collectionVariables.set('reset_otp', body.otp);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ]
            },
            "description": "Generate OTP for resetting password."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reset password status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('password', pm.collectionVariables.get('new_password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{reset_otp}}\",\n  \"password\": \"{{new_password}}\",\n  \"confirm_password\": \"{{new_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "reset-password"
              ]
            },
            "description": "Reset password with OTP from forgot-password."
          },
          "response": []
        }
      ]
    }
  ]
}
